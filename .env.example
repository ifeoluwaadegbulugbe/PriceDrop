# Copy to .env.local. Never commit real values. Only NEXT_PUBLIC_* reach the browser.

# Supabase: Project Settings > API. Required for accounts and tracking.
NEXT_PUBLIC_SUPABASE_URL=
# The anon key, or the newer publishable key (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY also works).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Channel3 (optional). Without it the labelled Demo catalogue is used.
CHANNEL3_API_KEY=
# Paid calls allowed per month. The free tier is 1,000 credits.
CHANNEL3_MONTHLY_BUDGET=300

# Gemini (optional). Without it, or with LLM_ENABLED=false, the app runs in basic mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_ENABLED=false
LLM_DAILY_CAP=100

# PayPal SANDBOX app credentials from developer.paypal.com. Never set ALLOW_LIVE_PAYPAL.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional. Webhook route answers 503 without it, and capture plus reconcile still work.
PAYPAL_WEBHOOK_ID=

# A random string of at least 16 characters. Used by the monitor route.
CRON_SECRET=

# true enables POST /api/demo/simulate-price and the simulate panel.
DEMO_MODE=false
